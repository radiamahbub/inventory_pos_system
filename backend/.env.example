# Optional. Exported as environment variables before running the server, e.g.:
#   export SECRET_KEY="a-long-random-string"
#   export DEBUG=False
SECRET_KEY=change-me
DEBUG=True

# Self-registration (default: enabled, but new accounts wait for Admin approval)
SELF_REGISTRATION_ENABLED=True
SELF_REGISTRATION_AUTO_APPROVE=False
# REGISTER_THROTTLE_RATE=10/hour

# Shop details shown on invoices, PDF and 80mm receipts
SHOP_NAME=My Shop
SHOP_ADDRESS=Shop 12, Main Road, Dhaka
SHOP_PHONE=01XXXXXXXXX
SHOP_RECEIPT_FOOTER=Thank you for your purchase!
# Optional: Unicode font files so PDFs can print Bengali text and the ৳ sign (otherwise "Tk" is used)
# PDF_FONT_REGULAR=/Users/you/fonts/NotoSansBengali-Regular.ttf
# PDF_FONT_BOLD=/Users/you/fonts/NotoSansBengali-Bold.ttf
